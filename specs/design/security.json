{
  "version": 3,
  "permissions": [
    {
      "resource": "todos",
      "component": "todo-api",
      "description": "A user's personal todo items",
      "actions": [
        { "handle": "read", "description": "The caller's own todos" },
        { "handle": "submit", "description": "Create, edit, and delete the caller's own todos" }
      ]
    }
  ],
  "groups": [],
  "roles": [
    {
      "name": "User",
      "description": "Signs in and manages their own private todo list.",
      "stories": [1, 2, 3, 4, 5, 6, 7],
      "grants": ["todos:read", "todos:submit"],
      "assignTo": ["Users"]
    }
  ],
  "testUsers": [
    { "username": "test-user", "roles": ["User"] }
  ]
}
